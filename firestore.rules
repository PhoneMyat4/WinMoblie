rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Data Immutability: Activity Logs & Audit Logs are strictly append-only.
    // Creates and reads are permitted; modifications and deletions are strictly forbidden to preserve audit integrity.
    match /activityLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // 2. POS Terminal Identity, Staff Credentials, & Store Configurations
    match /staffUsers/{staffId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /rolePermissions/{docId} {
      allow read, write: if true;
    }

    // 3. Standard POS & Inventory management collections
    match /{collection}/{docId} {
      allow read, write: if collection != 'activityLogs' && collection != 'auditLogs';
    }

    // Sub-collections catch-all
    match /{collection}/{docId}/{subCollection}/{subDocId} {
      allow read, write: if collection != 'activityLogs' && collection != 'auditLogs';
    }
  }
}

