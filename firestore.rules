rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && 
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // 1. Activity Logs & System Audit Logs: Append-only for authenticated staff; never mutable or deletable
    match /activityLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // 2. POS Terminal Identity, Staff Credentials, & Store Configurations
    match /staffUsers/{staffId} {
      allow read, write: if isSignedIn();
    }

    match /settings/{docId} {
      allow read, write: if isSignedIn();
    }

    match /rolePermissions/{docId} {
      allow read, write: if isSignedIn();
    }

    // 3. Multi-Branch & Logistics Architecture collections
    match /locations/{locId} {
      allow read, write: if isSignedIn();
    }

    match /branch_inventory/{docId} {
      allow read, write: if isSignedIn();
    }

    match /stock_transfers/{transferId} {
      allow read, write: if isSignedIn();
    }

    match /device_units/{imei} {
      allow read, write: if isSignedIn();
    }

    // 4. Sales & Invoices: Append and update only; no hard delete
    match /sales/{saleId} {
      allow read, create, update: if isSignedIn();
      allow delete: if false;
    }

    match /creditSales/{creditId} {
      allow read, write: if isSignedIn();
    }

    // 5. Products & Inventory
    match /products/{prodId} {
      allow read, write: if isSignedIn();
    }

    // 6. Purchases, Customers, Expenses, Cash Drawer
    match /purchases/{purchaseId} {
      allow read, write: if isSignedIn();
    }

    match /customers/{customerId} {
      allow read, write: if isSignedIn();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isSignedIn();
    }

    match /expenses/{expenseId} {
      allow read, write: if isSignedIn();
    }

    match /expenseCategories/{docId} {
      allow read, write: if isSignedIn();
    }

    match /cashDrawer/{docId} {
      allow read, write: if isSignedIn();
    }

    match /cashDrawerShifts/{shiftId} {
      allow read, write: if isSignedIn();
    }

    match /monthlyCapitalSnapshots/{snapId} {
      allow read, write: if isSignedIn();
    }

    match /capitalCashTransfers/{transferId} {
      allow read, write: if isSignedIn();
    }

    match /focDistributions/{docId} {
      allow read, write: if isSignedIn();
    }

    match /sales_archive/{saleId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }

    match /preOrders/{preOrderId} {
      allow read, write: if isSignedIn();
    }

    match /priceChanges/{docId} {
      allow read, write: if isSignedIn();
    }

    match /stockAdjustments/{docId} {
      allow read, write: if isSignedIn();
    }

    match /damageLogs/{docId} {
      allow read, write: if isSignedIn();
    }

    match /stockAudits/{docId} {
      allow read, write: if isSignedIn();
    }

    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }

    match /telegram_bot_state/{docId} {
      allow read, write: if isSignedIn();
    }

    match /telegram_processed_messages/{docId} {
      allow read, write: if isSignedIn();
    }

    match /socialMarketing/{docId} {
      allow read, write: if isSignedIn();
    }

    match /facebookPosts/{docId} {
      allow read, write: if isSignedIn();
    }

    match /announcements/{docId} {
      allow read, write: if isSignedIn();
    }

    match /chatChannels/{docId} {
      allow read, write: if isSignedIn();
    }

    match /chatMessages/{docId} {
      allow read, write: if isSignedIn();
    }

    match /personalWallets/{docId} {
      allow read, write: if isSignedIn();
    }

    match /personalTransactions/{docId} {
      allow read, write: if isSignedIn();
    }

    match /personalBudgets/{docId} {
      allow read, write: if isSignedIn();
    }

    match /personalGoals/{docId} {
      allow read, write: if isSignedIn();
    }

    match /personalDebts/{docId} {
      allow read, write: if isSignedIn();
    }

    // Default deny catch-all so specific collection restrictions (such as append-only audit logs and non-deletable sales) are never overridden
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
