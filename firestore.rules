rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null &&
        (!('firebase' in request.auth.token) || request.auth.token.firebase.sign_in_provider != 'anonymous');
    }

    function isBootstrappedOwnerEmail() {
      return isSignedIn() &&
        'email' in request.auth.token &&
        request.auth.token.email == 'phonemyatpaing950@gmail.com' &&
        'email_verified' in request.auth.token &&
        request.auth.token.email_verified == true;
    }

    function role() {
      return isBootstrappedOwnerEmail()
        ? 'Owner'
        : (('role' in request.auth.token && request.auth.token.role != null)
            ? request.auth.token.role
            : (exists(/databases/$(database)/documents/staffAccess/$(request.auth.uid))
                ? get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data.role
                : (exists(/databases/$(database)/documents/staffUsers/$(request.auth.uid))
                    ? get(/databases/$(database)/documents/staffUsers/$(request.auth.uid)).data.role
                    : 'none')));
    }

    function isStaff() {
      return isSignedIn() &&
        role() in ['Cashier', 'Inventory_Staff', 'Manager', 'Owner'];
    }

    function canManageInventory() {
      return isSignedIn() &&
        role() in ['Inventory_Staff', 'Manager', 'Owner'];
    }

    function isMgr() {
      return isSignedIn() &&
        role() in ['Manager', 'Owner'];
    }

    function isOwner() {
      return isSignedIn() &&
        role() == 'Owner';
    }

    // 1. Activity Logs & System Audit Logs: Append-only for authenticated staff; never mutable or deletable
    match /activityLogs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // 2. POS Terminal Identity, Staff Credentials, & Store Configurations (R1, R3, & Critical #2)
    match /staffAccess/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow create, update, delete: if isOwner();
    }

    match /staffUsers/{staffId} {
      allow read: if isStaff();
      // Only Owner can create or delete staff documents or modify roles; non-Owner staff can only update their own bound record without changing role or firebaseUid
      allow create, delete: if isOwner();
      allow update: if isOwner() || (
        isStaff() &&
        'firebaseUid' in resource.data &&
        resource.data.firebaseUid == request.auth.uid &&
        !('pin' in request.resource.data) &&
        !('password' in request.resource.data) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.firebaseUid == resource.data.firebaseUid
      );
    }

    match /settings/{docId} {
      allow read: if isStaff();
      allow write: if isMgr() || isStaff();
    }

    match /rolePermissions/{docId} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    // 3. Multi-Branch & Logistics Architecture collections
    match /locations/{locId} {
      allow read: if isStaff();
      allow write: if isMgr();
    }

    match /branch_inventory/{docId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /stock_transfers/{transferId} {
      allow read: if isStaff();
      allow write: if canManageInventory();
    }

    match /device_units/{imei} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // 4. Sales, Offline Sale Conflicts, & Credit Sales (R4)
    match /sales/{saleId} {
      allow read, create: if isStaff();
      allow update: if isStaff();
      allow delete: if false;
    }

    match /offlineSaleConflicts/{saleId} {
      allow read, create: if isStaff();
      allow update, delete: if isMgr();
    }

    match /creditSales/{creditId} {
      allow read, write: if isStaff();
    }

    // 5. Products & Inventory (R5)
    match /products/{prodId} {
      allow read: if isStaff();
      allow create, delete: if canManageInventory();
      allow update: if isStaff();
    }

    // 6. Purchases, Customers, Expenses, Cash Drawer
    match /purchases/{purchaseId} {
      allow read: if isStaff();
      allow write: if canManageInventory();
    }

    match /customers/{customerId} {
      allow read, write: if isStaff();
    }

    match /suppliers/{supplierId} {
      allow read: if isStaff();
      allow write: if canManageInventory();
    }

    match /expenses/{expenseId} {
      allow read, write: if isStaff();
    }

    match /expenseCategories/{docId} {
      allow read: if isStaff();
      allow write: if isMgr();
    }

    match /cashDrawer/{docId} {
      allow read, write: if isStaff();
    }

    match /cashDrawerShifts/{shiftId} {
      allow read, write: if isStaff();

      match /entries/{entryId} {
        allow read, create: if isStaff();
        allow update, delete: if false;
      }
    }

    match /monthlyCapitalSnapshots/{snapId} {
      allow read: if isMgr();
      allow write: if isOwner();
    }

    match /capitalCashTransfers/{transferId} {
      allow read: if isMgr();
      allow write: if isMgr();
    }

    match /focDistributions/{docId} {
      allow read, write: if isStaff();
    }

    match /sales_archive/{saleId} {
      allow read: if isMgr();
      allow create: if isMgr();
      allow update, delete: if false;
    }

    match /preOrders/{preOrderId} {
      allow read, write: if isStaff();
    }

    match /priceChanges/{docId} {
      allow read: if isStaff();
      allow write: if canManageInventory();
    }

    match /stockAdjustments/{docId} {
      allow read: if isStaff();
      allow write: if canManageInventory();
    }

    match /damageLogs/{docId} {
      allow read: if isStaff();
      allow write: if canManageInventory();
    }

    match /stockAudits/{docId} {
      allow read: if isStaff();
      allow write: if canManageInventory();
    }

    match /counters/{counterId} {
      allow read, write: if isStaff();
    }

    match /telegram_bot_state/{docId} {
      allow read, write: if isMgr();
    }

    match /telegram_processed_messages/{docId} {
      allow read, write: if isMgr();
    }

    match /socialMarketing/{docId} {
      allow read, write: if isMgr();
    }

    match /facebookPosts/{docId} {
      allow read, write: if isMgr();
    }

    match /announcements/{docId} {
      allow read: if isStaff();
      allow write: if isMgr();
    }

    match /chatChannels/{docId} {
      allow read, write: if isStaff();
    }

    match /chatMessages/{docId} {
      allow read, write: if isStaff();
    }

    // 7. Personal Finance: Strictly Owner-only
    match /personalWallets/{docId} {
      allow read, write: if isOwner();
    }

    match /personalTransactions/{docId} {
      allow read, write: if isOwner();
    }

    match /personalBudgets/{docId} {
      allow read, write: if isOwner();
    }

    match /personalGoals/{docId} {
      allow read, write: if isOwner();
    }

    match /personalDebts/{docId} {
      allow read, write: if isOwner();
    }

    // Default deny catch-all so specific collection restrictions are never overridden
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
