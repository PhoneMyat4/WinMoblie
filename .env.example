# OPENAI_API_KEY: Required for OpenAI GPT-4o-mini AI Copilot Assistant & Function Calling.
OPENAI_API_KEY=

# GEMINI_API_KEY: Required for box spec OCR extraction.
GEMINI_API_KEY=

# META / FACEBOOK PAGE INTEGRATION
# Numeric Facebook Page ID (e.g. 105827392819201)
FB_PAGE_ID=
# Non-expiring Meta Page Access Token (starts with EAA...) with 'pages_manage_posts' and 'pages_read_engagement' permissions
FB_PAGE_ACCESS_TOKEN=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# API Security Token (Used by middleware to protect all /api/* routes from unauthorized access)
API_AUTH_TOKEN=pos_sec_token_9938148
VITE_API_TOKEN=pos_sec_token_9938148

# MCP (Model Context Protocol) Server configuration (Optional custom credentials)
MCP_AUTH_EMAIL=
MCP_AUTH_PASSWORD=

# DIRECT TWO-WAY TELEGRAM BOT WEBHOOK INTEGRATION
# Telegram Bot API Token obtained from @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=
# Comma-separated list of authorized Telegram Chat IDs or User IDs for security
# e.g. 123456789,987654321
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional Telegram secret token sent in X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_SECRET_TOKEN=
